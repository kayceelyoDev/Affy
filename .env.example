# ==============================================================================
# Affiliate Autopilot Configuration Template (.env.example)
# Copy to .env and configure for your local environment.
# NEVER commit real tokens, passwords, chat IDs, or folder IDs.
# ==============================================================================

# --- Network & Server Ports ---
HOST_IP=0.0.0.0
API_PORT=8090
PWA_PORT=8091
PROXY_PORT=8030

# --- Environment & Debug ---
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
LOG_LEVEL=INFO

# --- Timezone & Region ---
APP_TIMEZONE=Asia/Manila
APP_CURRENCY=PHP
APP_LOCALE=en_PH

# --- Storage Paths ---
DATA_DIR=./data
CLIPS_DIR=./data/clips
RENDERS_DIR=./data/renders
MUSIC_DIR=./data/music
FONTS_DIR=./fonts

# --- Master Encryption & Auth ---
# 32-byte base64 key generated automatically during first run if omitted
# MASTER_ENCRYPTION_KEY=
# SESSION_SECRET_KEY=

# --- Feature Flags ---
ENABLE_TIKTOK_AUDIO=false
ENABLE_SHADOW_MODE=false
ENABLE_DIRECT_TIKTOK_API=false

# --- Seed Placeholders (Ephemeral, loaded into encrypted vault on first run) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BUFFER_ACCESS_TOKEN=
# BUFFER_CHANNEL_ID=
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=
# GOOGLE_DRIVE_FOLDER_ID_ROOT=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
