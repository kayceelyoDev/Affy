{
  "id": "punchy_zoom",
  "name": "Punchy Zoom",
  "version": "1.1",
  "description": "High-energy fast cuts (1.0 to 1.4s), explosive beat snap zoom, optical white flashes, dynamic whip pans, and bold TikTok yellow Anton typography.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 20,
    "preset": "veryfast",
    "pixel_format": "yuv420p"
  },
  "clip_rules": {
    "min_count": 4,
    "max_count": 16,
    "target_seg": 1.3,
    "min_duration": 10.0,
    "max_duration": 28.0,
    "crop_mode": "auto"
  },
  "cut_logic": {
    "mode": "beat_synced",
    "fixed_duration": 1.2,
    "beats_per_cut": 2
  },
  "transitions": {
    "enabled": true,
    "transitions": [
      { "type": "zoomin", "duration": 0.15, "weight": 2.0 },
      { "type": "whipleft", "duration": 0.15, "weight": 1.5 },
      { "type": "whipright", "duration": 0.15, "weight": 1.5 },
      { "type": "flash", "duration": 0.08, "weight": 2.0 }
    ]
  },
  "text_layers": [
    {
      "name": "title",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "0xEFD34C",
      "stroke_color": "black@0.95",
      "stroke_width": 5,
      "position_y": 240,
      "max_size": 130,
      "width_ratio": 0.84,
      "box": false,
      "animation": "pop_in"
    },
    {
      "name": "subtitle",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "white",
      "stroke_color": "black@0.95",
      "stroke_width": 4,
      "position_y": 380,
      "max_size": 115,
      "width_ratio": 0.84,
      "box": false,
      "animation": "pop_in"
    },
    {
      "name": "clip_caption",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "white",
      "stroke_color": "black@0.95",
      "stroke_width": 3,
      "position_y": 960,
      "max_size": 90,
      "width_ratio": 0.80,
      "box": true,
      "box_color": "black@0.65",
      "animation": "none"
    }
  ],
  "graphics": [],
  "motion": {
    "type": "zoom_punch",
    "intensity": 1.20
  },
  "audio": {
    "target_lufs": -13.5,
    "fade_out_sec": 0.8,
    "ducking": false,
    "normalize": true
  }
}
