{
  "id": "smooth_flow",
  "name": "Smooth Flow",
  "version": "1.1",
  "description": "Continuous 4-way luxury motorized gimbal drift, silky soft dissolves, aesthetic cinematic color grade with corner vignette, and title fading gracefully after 2.2s.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 20,
    "preset": "veryfast",
    "pixel_format": "yuv420p"
  },
  "clip_rules": {
    "min_count": 2,
    "max_count": 10,
    "target_seg": 2.6,
    "min_duration": 10.0,
    "max_duration": 28.0,
    "crop_mode": "auto"
  },
  "cut_logic": {
    "mode": "beat_synced",
    "fixed_duration": 2.6,
    "beats_per_cut": 4
  },
  "transitions": {
    "enabled": true,
    "transitions": [
      { "type": "dissolve", "duration": 0.25, "weight": 2.0 },
      { "type": "fade", "duration": 0.20, "weight": 2.0 },
      { "type": "glide", "duration": 0.30, "weight": 1.5 }
    ]
  },
  "text_layers": [
    {
      "name": "title",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "0xEFD34C",
      "stroke_color": "black@0.95",
      "stroke_width": 5,
      "position_y": 210,
      "max_size": 115,
      "width_ratio": 0.82,
      "box": false,
      "animation": "fade_out_2s"
    },
    {
      "name": "subtitle",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "white",
      "stroke_color": "black@0.95",
      "stroke_width": 4,
      "position_y": 340,
      "max_size": 105,
      "width_ratio": 0.82,
      "box": false,
      "animation": "fade_out_2s"
    },
    {
      "name": "clip_caption",
      "font_file": "fonts/Anton-Regular.ttf",
      "color": "0xFFFFFF",
      "stroke_color": "black@0.95",
      "stroke_width": 3,
      "position_y": 1550,
      "max_size": 75,
      "width_ratio": 0.85,
      "box": true,
      "box_color": "black@0.55",
      "animation": "none"
    }
  ],
  "graphics": [],
  "motion": {
    "type": "smooth_flow",
    "intensity": 1.08
  },
  "audio": {
    "target_lufs": -14.0,
    "fade_out_sec": 1.2,
    "ducking": false,
    "normalize": true
  }
}
